# Local MinIO development settings. Do not reuse these credentials outside local development.
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
MINIO_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=
MINIO_SECURE=false
MAX_IMAGE_UPLOAD_BYTES=10485760
MAX_IMAGE_PIXELS=50000000
VLM_MODEL=
VLM_BASE_URL=
# VLM_API_KEY may be omitted when OPENAI_API_KEY uses the same provider.
VLM_API_KEY=
CRITIC_MODEL=
CRITIC_BASE_URL=

LONG_TERM_MEMORY_BATCH_TURNS=3
LONG_TERM_MEMORY_CONTEXT_TURNS=12
LONG_TERM_MEMORY_RETRIEVAL_LIMIT=12
LONG_TERM_MEMORY_CHAR_BUDGET=2400

AUTH_SECRET_KEY=
AUTH_TOKEN_TTL_SECONDS=
AUTH_ISSUER=
AUTH_REQUIRED=true

CHECKPOINT_DB_PATH=

AGENT_TASK_POLL_INTERVAL_SECONDS=1.0
AGENT_TASK_LEASE_SECONDS=120
AGENT_TASK_MAX_ATTEMPTS=3
AGENT_TASK_RETRY_DELAY_SECONDS=5
AGENT_TASK_RECOVERY_INTERVAL_SECONDS=10
AGENT_TASK_EVENT_POLL_INTERVAL_SECONDS=0.25
AGENT_TASK_RESULT_WAIT_TIMEOUT_SECONDS=600
